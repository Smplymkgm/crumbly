#!/bin/sh
# Sella la versión de la app (meta app-version + ?v= de los <script>) cuando
# el commit toca index.html o js/. La app compara esa versión con la
# publicada para recargarse sola (ver revisarVersionNueva_ en index.html).
# Activar una vez por clon: git config core.hooksPath .githooks
git diff --cached --name-only | grep -qE '^(index\.html|js/)' || exit 0
v=$(date +%Y%m%d%H%M%S)
sed -i.bak -E "s/(name=\"app-version\" content=\")[^\"]*\"/\1$v\"/; s#(src=\"js/[A-Za-z]+\.js\?v=)[^\"]*\"#\1$v\"#g" index.html && rm -f index.html.bak
git add index.html
